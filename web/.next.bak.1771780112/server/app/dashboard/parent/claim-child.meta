{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dashboard/layout,_N_T_/dashboard/parent/layout,_N_T_/dashboard/parent/claim-child/layout,_N_T_/dashboard/parent/claim-child/page,_N_T_/dashboard/parent/claim-child"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dashboard/parent/claim-child/__PAGE__",
    "/dashboard/parent/claim-child",
    "/dashboard/parent",
    "/dashboard",
    "/_index",
    "/_head"
  ]
}